# Local/Compose configuration template. Never commit a real .env file.
POSTGRES_PASSWORD=replace-with-a-local-password
AETHERFLOW_ENVIRONMENT=development
AETHERFLOW_APPLICATION_NAME=AetherFlow API
AETHERFLOW_DEBUG=false
AETHERFLOW_API_HOST=127.0.0.1
AETHERFLOW_API_PORT=8000
AETHERFLOW_DATABASE_URL=postgresql+asyncpg://aetherflow:aetherflow@localhost:5432/aetherflow
AETHERFLOW_JWT_SECRET_KEY=replace-with-a-long-random-secret-for-local-development
AETHERFLOW_ACCESS_TOKEN_MINUTES=15
AETHERFLOW_REFRESH_TOKEN_DAYS=30
AETHERFLOW_REFRESH_COOKIE_NAME=aetherflow_refresh
AETHERFLOW_SECURE_COOKIES=false
AETHERFLOW_REFRESH_COOKIE_DOMAIN=
AETHERFLOW_LOGGING_LEVEL=INFO
AETHERFLOW_CORS_ORIGINS=["http://localhost:3000"]
AETHERFLOW_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AETHERFLOW_KAFKA_TOPIC=aetherflow.jobs
AETHERFLOW_KAFKA_CONSUMER_GROUP=aetherflow-workers
AETHERFLOW_KAFKA_CLIENT_ID=aetherflow
AETHERFLOW_KAFKA_AUTO_OFFSET_RESET=earliest
AETHERFLOW_KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
AETHERFLOW_PROVIDER_DEFAULT=mock
AETHERFLOW_PROVIDER_OPENAI_API_KEY=
AETHERFLOW_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AETHERFLOW_PROVIDER_OPENAI_MAX_CONNECTIONS=10
AETHERFLOW_PROVIDER_OPENAI_TIMEOUT_SECONDS=60
AETHERFLOW_REDIS_ENABLED=false
AETHERFLOW_REDIS_URL=redis://localhost:6379/0
AETHERFLOW_REDIS_MAX_CONNECTIONS=10
AETHERFLOW_REDIS_CONNECT_TIMEOUT_SECONDS=1
AETHERFLOW_REDIS_SOCKET_TIMEOUT_SECONDS=1
AETHERFLOW_RATE_LIMIT_AUTH_REQUESTS=20
AETHERFLOW_RATE_LIMIT_API_REQUESTS=120
AETHERFLOW_RATE_LIMIT_WINDOW_SECONDS=60
AETHERFLOW_KAFKA_ENABLED=false
AETHERFLOW_WORKER_ID=aetherflow-worker
AETHERFLOW_DATABASE_POOL_SIZE=5
AETHERFLOW_DATABASE_MAX_OVERFLOW=10
AETHERFLOW_DATABASE_POOL_RECYCLE_SECONDS=1800
AETHERFLOW_OUTBOX_POLL_INTERVAL_SECONDS=1
AETHERFLOW_OUTBOX_BATCH_SIZE=100
AETHERFLOW_OUTBOX_LEASE_SECONDS=60
