# Phase 1 local backend configuration. Never commit a real .env file.
AETHERFLOW_ENVIRONMENT=development
AETHERFLOW_APPLICATION_NAME=AetherFlow API
AETHERFLOW_DEBUG=false
AETHERFLOW_API_HOST=127.0.0.1
AETHERFLOW_API_PORT=8000
AETHERFLOW_DATABASE_URL=postgresql+asyncpg://aetherflow:aetherflow@localhost:5432/aetherflow
AETHERFLOW_JWT_SECRET_KEY=replace-with-a-long-random-secret-for-local-development
AETHERFLOW_ACCESS_TOKEN_MINUTES=15
AETHERFLOW_REFRESH_TOKEN_DAYS=30
AETHERFLOW_REFRESH_COOKIE_NAME=aetherflow_refresh
AETHERFLOW_SECURE_COOKIES=false
AETHERFLOW_REFRESH_COOKIE_DOMAIN=
AETHERFLOW_LOGGING_LEVEL=INFO
AETHERFLOW_CORS_ORIGINS=["http://localhost:3000"]
